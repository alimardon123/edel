#!/bin/sh
# Suspends the machine (M5.10c), run as root through doas by the lock and
# login screens' power menu: to memory when the kernel offers it, else to
# idle (s2idle), which every kernel with suspend offers.
set -eu
states=$(cat /sys/power/state 2>/dev/null || true)
case " $states " in
*" mem "*) echo mem >/sys/power/state ;;
*" freeze "*) echo freeze >/sys/power/state ;;
*)
	echo "edel-suspend: this machine cannot suspend (/sys/power/state offers: ${states:-nothing})" >&2
	exit 1
	;;
esac
