#!/bin/sh
# The store (M6.4): Bazaar lists the person's own Flatpak remotes and
# installs into the person's own installation, which needs no polkit. Each
# person gets Flathub once, from the file the image carries, offline; the
# check reads one file, so a login runs no flatpak when it is there.
flathub_repo_file=$(. /usr/share/edel/places.sh && echo "$flathub_repo_file")
if [ -f "$flathub_repo_file" ] && ! grep -qs '^\[remote "flathub"\]' "$HOME/.local/share/flatpak/repo/config"; then
	flatpak --user remote-add --if-not-exists --from flathub "$flathub_repo_file" >/dev/null 2>&1 &
fi

# The person's session (roadmap M4.2b, M3.6): what greetd starts after a
# login, from shell-ui's greeter (etc/greetd/config.toml) or, on a
# stick, for the person called live (edel boot live). Our compositor with
# a session bus, which apps and portals talk over, in a session named
# Edel (XDG_CURRENT_DESKTOP), which apps and the portals go by (M5.5a).
# Qt apps, in Flatpak's sandbox too, read the colour scheme, fonts and
# accent from the settings portal (QT_QPA_PLATFORMTHEME, M6.2a).
env XDG_CURRENT_DESKTOP=Edel QT_QPA_PLATFORMTHEME=xdgdesktopportal dbus-run-session -- edel-compositor
status=$?

# What the session started and left running when the compositor ended, a
# crash included (PipeWire, WirePlumber, an app), ends with it. greetd
# closes the session once this script returns, and pam_rundir then
# empties /run/user/UID; a process still writing there makes that fail,
# and pam_rundir then gives this person no runtime directory at any later
# login until the machine restarts. greetd made the session (setsid), and
# its own process in it is root's, which kill cannot touch.
ours() {
	left=
	for pid in $(pgrep -s 0); do
		[ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null && left="$left $pid"
	done
	[ -n "$left" ]
}
# Each signal waits up to 3 s for the processes to go.
for signal in TERM KILL; do
	ours || break
	kill -s "$signal" $left 2>/dev/null
	i=0
	while ours && [ "$i" -lt 30 ]; do
		sleep 0.1
		i=$((i + 1))
	done
done

# A FUSE mount the session left in its runtime directory, such as the
# document portal's /run/user/UID/doc (Flatpak apps, M6.1), outlives the
# process that served it, and pam_rundir cannot empty the directory past
# it, so this person would get no runtime directory at the next login.
# Each is unmounted lazily; a mount that is not ours is left alone.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
	while read -r _ point type _; do
		case "$point" in
		"$XDG_RUNTIME_DIR"/*)
			case "$type" in
			fuse*) fusermount3 -uz "$point" 2>/dev/null || fusermount -uz "$point" 2>/dev/null ||
				echo "edel-session: could not unmount $point; the next login may have no runtime directory" >&2 ;;
			esac ;;
		esac
	done </proc/mounts
fi
exit "$status"
