#!/bin/sh
# The person's session (roadmap M4.2b, M3.6): what greetd starts after a
# login, from the greeter's agreety (etc/greetd/config.toml) or, on a
# stick, for the person called live (edel boot live). Our compositor with
# a session bus, which apps and portals talk over, in a session named
# Edel (XDG_CURRENT_DESKTOP), which apps and the portals go by (M5.5a).
env XDG_CURRENT_DESKTOP=Edel dbus-run-session -- edel-compositor
status=$?

# What the session started and left running when the compositor ended, a
# crash included (PipeWire, WirePlumber, an app), ends with it. greetd
# closes the session once this script returns, and pam_rundir then
# empties /run/user/UID; a process still writing there makes that fail,
# and pam_rundir then gives this person no runtime directory at any later
# login until the machine restarts. greetd made the session (setsid), and
# its own process in it is root's, which kill cannot touch.
ours() {
	left=
	for pid in $(pgrep -s 0); do
		[ "$pid" != $$ ] && kill -0 "$pid" 2>/dev/null && left="$left $pid"
	done
	[ -n "$left" ]
}
# Each signal waits up to 3 s for the processes to go.
for signal in TERM KILL; do
	ours || break
	kill -s "$signal" $left 2>/dev/null
	i=0
	while ours && [ "$i" -lt 30 ]; do
		sleep 0.1
		i=$((i + 1))
	done
done
exit "$status"
