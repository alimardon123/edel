#!/sbin/openrc-run
# Started from a USB stick, or in a virtual machine nobody has set up yet,
# the desktop logs a person called live in by itself, so it shows without
# a login (roadmap M3.6). edel boot live makes the account, a system one
# kept in /etc's overlay on the data partition, never in the slot or the
# settings file, and writes /run/edel/greetd.toml, greetd's config with that
# session, which conf.d/greetd then uses. On an installed machine, whose
# people have accounts, it does nothing and the greeter asks who logs in.
# First it makes the login screen's directory on the data partition, owned
# by greetd, where the greeter keeps each person's chosen desktop (M5.10c3b).

description="Log the live person in on a USB stick"

depend() {
	need localmount
	after edel-settings
	before greetd
}

start() {
	. /usr/share/edel/places.sh
	# A login screen that cannot keep a choice still logs people in, so a
	# failure here is a warning, never a stop to the live login below.
	checkpath -d -m 0755 -o greetd:greetd "$greeter_dir" ||
		ewarn "the login screen will not remember each person's desktop: $greeter_dir could not be made"
	ebegin "Checking for a USB stick"
	/usr/bin/edel boot live
	eend $?
}
