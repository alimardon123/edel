# /etc/inittab for Edel OS VM images: Alpine's defaults plus a login on the
# serial console, which is how cloud and headless VMs are reached. Each
# console starts with edel-console, which asks for the first person when
# nobody can log in (M6.6b) and then runs getty.

::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default

tty1::respawn:/usr/libexec/edel-console 38400 tty1
ttyS0::respawn:/usr/libexec/edel-console -L 115200 ttyS0 vt100

::ctrlaltdel:/sbin/reboot
::shutdown:/sbin/openrc shutdown
