# The person at the screen plays with their controllers (roadmap M7.6b,
# M8.37): steam-devices' rules (60-steam-input.rules, 60-steam-vr.rules)
# mark the controllers' and VR headsets' hidraw and USB devices, and
# /dev/uinput, where Steam Input makes the pad games see, for uaccess,
# which only logind acts on. Edel OS has none, so each such node is made
# root's with mode 600, tagged edel-seat, and given by edel-seat (the seat
# feature) to the person whose session is at the screen alone, as greetd
# opens and closes sessions; this file is the one place that names them.
TAG=="uaccess", SUBSYSTEM=="hidraw|usb|misc", ENV{DEVNAME}=="?*", OWNER="root", GROUP="root", MODE="0600", TAG+="edel-seat", RUN+="/usr/libexec/edel-seat device $devnode"
# A controller's own input device, which games read through SDL, as logind
# would give it; only joysticks, never a keyboard.
SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_JOYSTICK}=="1", ENV{ID_INPUT_KEYBOARD}!="1", OWNER="root", GROUP="root", MODE="0600", TAG+="edel-seat", RUN+="/usr/libexec/edel-seat device $devnode"
# Proton's fast sync (M8.33): games open /dev/ntsync, root's alone unless a
# rule says otherwise, so the people at the machine get it; it types into
# nothing, so group seat is enough.
KERNEL=="ntsync", SUBSYSTEM=="misc", GROUP="seat", MODE="0660"
