#!/sbin/openrc-run
# Makes /run/edel/session (roadmap M4.1): the compositor, running as the
# person at the machine, leaves its health file `ready` (M4.8) and its
# `state.toml` there, and root reads them. Only members of the seat group
# may write it. It has no sticky bit (M4.7b): the greeter's compositor
# (user greetd) and then the person's write the same files, each
# replacing the other's by a rename, and the compositor only ever creates
# its new files, so a link planted there is never followed. /run/edel
# itself stays root's alone, so no session can plant a file or a link
# where root writes its own (the update lock, the confirmation of the
# slot).

description="Let the session leave files for root"

depend() {
	before seatd greetd
}

start() {
	# Edel OS's places, written by edel::places (M5.27).
	. /usr/share/edel/places.sh
	checkpath -d -m 0755 -o root:root "$run_dir"
	checkpath -d -m 0770 -o root:seat "$session_dir"
}
