#!/sbin/openrc-run
# Applies the machine's settings file at every boot, seeding it on the
# first (roadmap M2.2, M5.25a): the hostname, people, their ssh keys and
# developer mode. Before hostname, so the machine boots with the hostname
# the file names; /data is mounted in sysinit by edel-data.

description="Apply the Edel OS settings"

depend() {
	need localmount
	before hostname
}

start() {
	ebegin "Applying the settings"
	# One stuck step must never stop the boot (the guard would restart
	# the machine, again and again): the boot goes on after 60 s.
	timeout 60 /usr/bin/edel settings apply --boot
	eend $?
}
