#!/sbin/openrc-run
# Laptop image only (roadmap M3.4): leaves `edel report` at
# /EFI/edel/report.toml on the stick's EFI system partition at every boot.
# The stick has no login and no Wi-Fi set up yet, so a person boots it on
# their laptop, plugs it into any computer and attaches that file to an
# issue (docs/TRY-IT.md). It runs once and exits; it serves nothing. On a
# disk that is no stick (an installed laptop, on its own disk or a USB
# one, M6.17) it writes nothing.
# It comes after edel-boot-ok but does not need it to succeed, so a stick
# whose slot is not healthy still leaves its report (M6.17).

description="Leave a hardware report on the EFI system partition"

depend() {
	after edel-boot-ok
}

start() {
	ebegin "Writing the hardware report to the EFI system partition"
	/usr/bin/edel report --esp
	eend $?
}
