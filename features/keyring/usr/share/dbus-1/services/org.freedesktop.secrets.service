# The keyring (M7.18), started by the session's D-Bus only when an app
# first asks. Alpine's file starts it through systemd, which Edel OS has
# not, so this one replaces it: edel boot keyring becomes oo7's daemon,
# given the session's keyring key so the keyring opens with no prompt.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/usr/bin/edel boot keyring
