#!/sbin/openrc-run
# Reads a cloud's user data as the first settings file once the network is
# up (roadmap M7.4): `edel boot cloud`, started in the background, so a
# slow metadata address never holds up the default runlevel or
# edel-boot-ok. It does nothing on a machine that has a settings file or
# is not on a known cloud, and restarts the machine once when it keeps
# one, so the boot applies it as it applies a seed.

description="Read a cloud's user data as the first settings file"

depend() {
	after networkmanager
	use logger
}

start() {
	edel boot cloud >/dev/console 2>&1 &
	return 0
}
