#!/bin/sh
# desktop-test's screen reader (M5.1d): run as the session's person with
# DBUS_SESSION_BUS_ADDRESS set, it turns accessibility on as a screen
# reader does, waits up to 10 s for edel-shell-ui to join the AT-SPI
# registry, and prints its tree, one node a line: DEPTH ROLE: NAME, the
# role as AT-SPI numbers it, named for the roles shell-ui uses.
set -u

call() {
	gdbus call "$@" 2>/dev/null
}

# The one string in gdbus's answer, ('...',) or (<'...'>,).
string() {
	sed -n "s/^(<*'\(.*\)'>*,)\$/\1/p"
}

# The children in gdbus's answer, one "BUSNAME PATH" a line; only the
# first path carries its type.
children() {
	grep -oE "\('[^']*', (objectpath )?'[^']*'\)" | sed -E "s/^\('([^']*)', (objectpath )?'([^']*)'\)\$/\1 \3/"
}

# AT-SPI's role numbers (atspi-constants.h) for the roles shell-ui uses.
role_name() {
	case "$1" in
	23) echo frame ;;
	29) echo label ;;
	43) echo button ;;
	75) echo application ;;
	*) echo "role $1" ;;
	esac
}

set=$(gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
	--method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled '<true>' 2>&1)
got=$(gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus --method org.a11y.Bus.GetAddress 2>&1)
a11y=$(echo "$got" | string)
[ -n "$a11y" ] || {
	# Why, for the log: the session bus asked, and what each call said.
	echo "no accessibility bus on ${DBUS_SESSION_BUS_ADDRESS:-no session bus}: setting IsEnabled said \"$set\", GetAddress said \"$got\"" | tr '\n' ' '
	echo
	exit 1
}

name_of() {
	call --address "$a11y" --dest "$1" --object-path "$2" \
		--method org.freedesktop.DBus.Properties.Get org.a11y.atspi.Accessible Name | string
}

# walk BUSNAME PATH DEPTH: the node, then its children, three deep.
walk() {
	local role children
	role=$(call --address "$a11y" --dest "$1" --object-path "$2" --method org.a11y.atspi.Accessible.GetRole | sed -n 's/^(uint32 \([0-9]*\),)$/\1/p')
	role=$(role_name "$role")
	echo "$3 $role: $(name_of "$1" "$2")"
	[ "$3" -lt 3 ] || return 0
	children=$(call --address "$a11y" --dest "$1" --object-path "$2" --method org.a11y.atspi.Accessible.GetChildren | children)
	echo "$children" | while read -r bus path; do
		[ -n "$bus" ] && walk "$bus" "$path" $(($3 + 1))
	done
}

i=0
while [ "$i" -lt 50 ]; do
	apps=$(call --address "$a11y" --dest org.a11y.atspi.Registry \
		--object-path /org/a11y/atspi/accessible/root --method org.a11y.atspi.Accessible.GetChildren | children)
	app=$(echo "$apps" | while read -r bus path; do
		[ -n "$bus" ] && [ "$(name_of "$bus" "$path")" = edel-shell-ui ] && echo "$bus $path"
	done | head -n 1)
	if [ -n "$app" ]; then
		walk ${app% *} ${app#* } 1
		exit 0
	fi
	i=$((i + 1))
	sleep 0.2
done
echo "edel-shell-ui did not join the AT-SPI registry; it holds: $(echo "$apps" | tr '\n' ' ')"
exit 1
