#!/sbin/openrc-run
# Test only (roadmap M4.1, M4.2b, M4.3): CI builds this into
# ci/desktop/vm.toml. greetd logs user ci (from the seed system file, put
# in the seat group by edel system apply) in to the compositor at once.
# This service waits for the compositor's health file, then, as ci, times
# 10 s of frames with weston-presentation-shm, reads the compositor's
# telemetry and memory, and opens foot and two test clients, each once the
# one before is on screen, so they cascade in a known order. It prints the
# results and the compositor's state file on the serial console, where
# ci/desktop-test.sh reads them.

description="Edel OS desktop test"

depend() {
	after edel-system
	before greetd
}

say() {
	echo "DESKTOP-TEST: $*" >/dev/console
}

# Everything that tells why the session did not come up.
dump() {
	{
		id ci
		ls -l /run/user /run/edel/session /dev/dri
		ps | grep -v ' \['
		tail -n 30 /var/log/messages
		cat /var/log/greetd.log /tmp/compositor.log
	} >/dev/console 2>&1
}

report() {
	dir=/run/user/$(id -u ci)
	i=0
	while [ ! -s /run/edel/session/ready ] && [ "$i" -lt 600 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	ready=$(cut -d' ' -f1 /proc/uptime)
	say "rundir $(stat -c '%a %U' "$dir" 2>&1)"
	if [ ! -s /run/edel/session/ready ]; then
		say "FAIL: no /run/edel/session/ready after 120 s; what follows is for finding out why"
		dump
		return
	fi
	say "ready_seconds $ready"
	say "ready_line $(cat /run/edel/session/ready)"
	socket=$(ls "$dir" | grep -E '^wayland-[0-9]+$' | head -n 1)
	as_ci() {
		su -s /bin/sh ci -c "XDG_RUNTIME_DIR=$dir WAYLAND_DISPLAY=$socket $*"
	}
	# Lines hold "p2p N us": microseconds since the previous presented frame.
	as_ci timeout -s INT 10 weston-presentation-shm >/tmp/frames.txt 2>&1
	frames=$(awk '{ for (i = 1; i < NF; i++) if ($i == "p2p" && $(i + 1) > 0) print $(i + 1) }' /tmp/frames.txt | sort -n)
	count=$(echo "$frames" | grep -c . || true)
	for p in 50 99; do
		say "frame_p${p}_ms $(echo "$frames" | awk -v n="$count" -v p="$p" 'NR == int(n * p / 100 + 0.999) { printf "%.1f", $1 / 1000 }')"
	done
	say "frames $count"
	# The compositor logs its telemetry once the screen is still for 2 s.
	sleep 4
	telemetry=$(grep 'edel-compositor: frames' /tmp/compositor.log | tail -n 1)
	say "telemetry ${telemetry#edel-compositor: }"
	say "idle_frames $(echo "$telemetry" | sed -n 's/.*idle frames \([0-9][0-9]*\).*/\1/p')"
	pid=$(pidof edel-compositor)
	say "compositor_rss_mib $(awk '/^VmRSS:/ { printf "%.1f", $2 / 1024 }' "/proc/$pid/status")"
	say "memory_in_use_mib $(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%.0f", (t - a) / 1024 }' /proc/meminfo)"
	# Windows open centred, each 32 px down and right of an open window
	# whose centre it would share (M4.3): foot first, then one, then two.
	as_ci foot --window-size-pixels=400x300 </dev/null >/dev/null 2>&1 &
	shown 1
	as_ci edel-testclient --size 300x200 --colour cc3333 --title one </dev/null >/dev/null 2>&1 &
	shown 2
	as_ci edel-testclient --size 200x150 --colour 3366cc --title two </dev/null >/dev/null 2>&1 &
	shown 3
	while IFS= read -r line; do
		say "state $line"
	done </run/edel/session/state.toml
	say "done"
}

# shown N: waits up to 30 s for the state file to list N windows.
shown() {
	i=0
	while [ "$i" -lt 150 ]; do
		n=$(grep -c '^\[\[windows\]\]' /run/edel/session/state.toml 2>/dev/null || true)
		[ "${n:-0}" -ge "$1" ] && return
		sleep 0.2
		i=$((i + 1))
	done
}

start() {
	report </dev/null >/dev/null 2>&1 &
	return 0
}
