#!/sbin/openrc-run
# Test only (roadmap M4.1 to M4.5): CI builds this into
# ci/desktop/vm.toml. greetd logs user ci (from the seed system file, put
# in the seat group by edel system apply) in to the compositor at once.
# This service waits for the compositor's health file, then, as ci, times
# 10 s of frames with weston-presentation-shm, reads the compositor's
# telemetry and memory, and opens foot and two test clients, each once the
# one before is on screen, so they cascade in a known order. It prints the
# results and the compositor's state file on the serial console, where
# ci/desktop-test.sh reads them; then, while that script clicks and drags,
# the windows each time they change and the compositor's log as it grows,
# and it runs the few commands that script sends over the VM's second
# serial port (/dev/ttyS1), such as `tiling on`.

description="Edel OS desktop test"

depend() {
	after edel-system
	before greetd
}

say() {
	echo "DESKTOP-TEST: $*" >/dev/console
}

# Everything that tells why the session did not come up.
dump() {
	{
		id ci
		ls -l /run/user /run/edel/session /dev/dri
		ps | grep -v ' \['
		tail -n 30 /var/log/messages
		cat /var/log/greetd.log /tmp/compositor.log
	} >/dev/console 2>&1
}

report() {
	dir=/run/user/$(id -u ci)
	i=0
	while [ ! -s /run/edel/session/ready ] && [ "$i" -lt 600 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	ready=$(cut -d' ' -f1 /proc/uptime)
	say "rundir $(stat -c '%a %U' "$dir" 2>&1)"
	if [ ! -s /run/edel/session/ready ]; then
		say "FAIL: no /run/edel/session/ready after 120 s; what follows is for finding out why"
		dump
		return
	fi
	say "ready_seconds $ready"
	# Each screen the GPU offers and whether one is plugged in (M4.6c).
	for c in /sys/class/drm/card*-*/status; do
		[ -e "$c" ] && say "connector $(basename "$(dirname "$c")") $(cat "$c")"
	done
	say "ready_line $(cat /run/edel/session/ready)"
	socket=$(ls "$dir" | grep -E '^wayland-[0-9]+$' | head -n 1)
	as_ci() {
		su -s /bin/sh ci -c "XDG_RUNTIME_DIR=$dir WAYLAND_DISPLAY=$socket $*"
	}
	# Lines hold "p2p N us": microseconds since the previous presented frame.
	as_ci timeout -s INT 10 weston-presentation-shm >/tmp/frames.txt 2>&1
	frames=$(awk '{ for (i = 1; i < NF; i++) if ($i == "p2p" && $(i + 1) > 0) print $(i + 1) }' /tmp/frames.txt | sort -n)
	count=$(echo "$frames" | grep -c . || true)
	for p in 50 99; do
		say "frame_p${p}_ms $(echo "$frames" | awk -v n="$count" -v p="$p" 'NR == int(n * p / 100 + 0.999) { printf "%.1f", $1 / 1000 }')"
	done
	say "frames $count"
	# The compositor logs its telemetry once the screen is still for 2 s.
	sleep 4
	telemetry=$(grep 'edel-compositor: frames' /tmp/compositor.log | tail -n 1)
	say "telemetry ${telemetry#edel-compositor: }"
	say "idle_frames $(echo "$telemetry" | sed -n 's/.*idle frames \([0-9][0-9]*\).*/\1/p')"
	pid=$(pidof edel-compositor)
	say "compositor_rss_mib $(awk '/^VmRSS:/ { printf "%.1f", $2 / 1024 }' "/proc/$pid/status")"
	# The X11 display (M4.7), logged before follow prints the log, and no
	# X11 process yet: they start with the first X11 app.
	say "x11 $(grep 'edel-compositor: X11 apps' /tmp/compositor.log | tail -n 1)"
	say "x11_processes $(pgrep -f 'Xwayland|xwayland-satellite' | wc -l)"
	say "memory_in_use_mib $(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { printf "%.0f", (t - a) / 1024 }' /proc/meminfo)"
	# Every screen's first frame, not only the first screen's (M4.6c).
	grep 'edel-compositor: output .* ready' /tmp/compositor.log | while IFS= read -r line; do
		say "screen ${line#edel-compositor: }"
	done
	# Every protocol the compositor offers, as wayland-info lists them.
	say "globals $(as_ci wayland-info 2>/dev/null | sed -n "s/.*interface: '\([^']*\)'.*/\1/p" | sort | tr '\n' ' ')"
	# Window frames open centred, each 32 px down and right of an open
	# window whose centre it would share (M4.3): foot first, then one,
	# then two, each with a title bar (M4.4).
	as_ci foot --window-size-pixels=400x300 </dev/null >/dev/null 2>&1 &
	shown 1
	as_ci edel-testclient --size 300x200 --colour cc3333 --title one </dev/null >/dev/null 2>&1 &
	shown 2
	as_ci edel-testclient --size 200x150 --colour 3366cc --title two </dev/null >/dev/null 2>&1 &
	shown 3
	while IFS= read -r line; do
		say "state $line"
	done </run/edel/session/state.toml
	say "done"
	commands &
	follow
}

# commands: runs what ci/desktop-test.sh sends over the second serial
# port, one known command a line, as root, and says how each ended.
commands() {
	stty -F /dev/ttyS1 clocal -echo 2>/dev/null
	exec 3</dev/ttyS1
	say "commands: reading ttyS1"
	while read -r command <&3; do
		case "$command" in
		'tiling on') edel system set shell.tiling=true ;;
		'tiling off') edel system set shell.tiling=false ;;
		'scale 2') edel system set outputs.Virtual-1.scale=2 ;;
		'screen 2 off') edel system set outputs.Virtual-2.enabled=false ;;
		# An X11 app (M4.7) on the compositor's X11 display, and then the
		# memory of what it started.
		xclock)
			as_ci "DISPLAY=$(sed -n 's/.*X11 apps on \(:[0-9]*\).*/\1/p' /tmp/compositor.log | tail -n 1) xclock" </dev/null &
			(sleep 5 && say "x11_rss_mib $(x11_rss)") &
			;;
		# The session's compositor dies (M4.7b): greetd should start its
		# greeter, our compositor, which writes a new ready line; then ci
		# logs in through it with a password only this image sets.
		'kill compositor')
			echo 'ci:edel-desktop-test' | chpasswd
			before=$(cut -d' ' -f1 /proc/uptime)
			pkill -9 -x edel-compositor
			respawned "$before" &
			;;
		*)
			say "unknown command $command"
			continue
			;;
		esac >/dev/null 2>&1
		say "ran $command: $?"
	done
	say "commands: ttyS1 closed"
}

# follow: for 5 minutes, the compositor's log lines as they come and the
# windows each time they change, for the cases that click and drag.
follow() {
	tail -n 0 -f /tmp/compositor.log >/dev/console 2>&1 &
	last=''
	i=0
	while [ "$i" -lt 1500 ]; do
		now=$(windows)
		if [ "$now" != "$last" ]; then
			say "windows $now"
			last=$now
		fi
		sleep 0.2
		i=$((i + 1))
	done
	kill $! 2>/dev/null
}

# windows: how many windows the state file lists, then each as
# title@x,y,widthxheight, bottom first, spaces in titles as _.
windows() {
	awk -F' = ' '
		function flush() {
			if (t != "") out = out " " t "@" x "," y "," w "x" h
			t = ""
		}
		/^\[/ { flush() }
		/^\[\[windows\]\]/ { n++ }
		$1 == "title" { t = $2; gsub(/"/, "", t); gsub(/ /, "_", t) }
		$1 == "x" { x = $2 }
		$1 == "y" { y = $2 }
		$1 == "width" { w = $2 }
		$1 == "height" { h = $2 }
		END { flush(); print n + 0 out }
	' /run/edel/session/state.toml 2>/dev/null
}

# respawned SINCE: waits up to 15 s for the greeter's compositor to log
# its first frame, then says how long after SINCE (uptime seconds) that
# was, and whose the health file now is; then waits up to 60 s for ci's
# compositor, once ci has logged in through the greeter, to take the
# health file back.
respawned() {
	i=0
	while ! grep -q 'edel-compositor: output .* ready' /tmp/greeter.log 2>/dev/null; do
		i=$((i + 1))
		if [ "$i" -ge 150 ]; then
			say "respawn: no ready line from the greeter in 15 s"
			cat /var/log/greetd.log /tmp/greeter.log >/dev/console 2>&1
			return
		fi
		sleep 0.1
	done
	now=$(cut -d' ' -f1 /proc/uptime)
	say "greeter $(grep 'edel-compositor: output .* ready' /tmp/greeter.log | head -n 1)"
	say "ready_owner $(stat -c %U /run/edel/session/ready)"
	say "respawn_seconds $(awk -v a="$1" -v b="$now" 'BEGIN { printf "%.2f", b - a }')"
	i=0
	while [ "$(stat -c %U /run/edel/session/ready)" != ci ] && [ "$i" -lt 600 ]; do
		sleep 0.1
		i=$((i + 1))
	done
	say "login_ready $(stat -c %U /run/edel/session/ready) $(cat /run/edel/session/ready)"
}

# x11_rss: the memory XWayland and xwayland-satellite use, in MiB.
x11_rss() {
	for pid in $(pgrep -f 'Xwayland|xwayland-satellite'); do
		awk '/^VmRSS:/ { print $2 }' "/proc/$pid/status"
	done | awk '{ kib += $1 } END { printf "%.1f", kib / 1024 }'
}

# shown N: waits up to 30 s for the state file to list N windows.
shown() {
	i=0
	while [ "$i" -lt 150 ]; do
		n=$(grep -c '^\[\[windows\]\]' /run/edel/session/state.toml 2>/dev/null || true)
		[ "${n:-0}" -ge "$1" ] && return
		sleep 0.2
		i=$((i + 1))
	done
}

start() {
	report </dev/null >/dev/null 2>&1 &
	return 0
}
