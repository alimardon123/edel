#!/sbin/openrc-run
# Test only: CI builds this into the A/B test image with
# `edel image build --files ci/ab-test/files`; release images never have it.
# Each boot runs the next step of the test, then restarts the VM. The step
# number lives on the EFI system partition, which both slots share.
#
#   1. Slot A runs. Install the update (the disk with no partitions) into
#      slot B.
#   2. Slot B runs and is confirmed. Roll back to slot A by command.
#   3. Slot A runs again. Install the update into slot B, then break slot
#      B's initramfs, the way a bad update could.
#   4. Slot B panicked on each of its three tries, so GRUB started slot A
#      again: slot A runs, slot B is switched off, and a rollback to it is
#      refused.

description="Edel OS A/B update test"

depend() {
	need edel-boot-ok
}

ab_say() {
	echo "AB-TEST: $*"
}

ab_end() {
	ab_say "$1"
	umount "$esp" 2>/dev/null || true
	(sleep 1 && poweroff) &
}

# ab_expect LINE...: each LINE must start a line of `edel update status`.
ab_expect() {
	for line in "$@"; do
		echo "$slots" | grep -q "^$line" || {
			ab_end "FAIL: step $step expected \"$line\""
			return 1
		}
	done
}

ab_next() {
	echo "$1" >"$esp/ab-test-step"
	sync
	umount "$esp"
	ab_say "step $step done, restarting for step $1"
	(sleep 1 && reboot) &
}

start() {
	esp=/run/ab-test/esp
	mkdir -p "$esp"
	mount -t vfat -o iocharset=iso8859-1 "$(findfs LABEL=EDEL-ESP)" "$esp"
	step=$(cat "$esp/ab-test-step" 2>/dev/null || echo 1)
	slots=$(/usr/bin/edel update status)
	ab_say "step $step"
	echo "$slots"

	# The update is the second disk: a bare filesystem, no partitions.
	update=''
	for d in /sys/block/vd*; do
		[ -e "$d/${d##*/}1" ] || update=/dev/${d##*/}
	done

	case "$step" in
	1)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0" || return 0
		/usr/bin/edel update install "$update" || { ab_end "FAIL: installing into slot B"; return 0; }
		ab_next 2
		;;
	2)
		ab_expect "running: B" "order: B A" "B: ok=1 try=0" "A: ok=1 try=0" || return 0
		/usr/bin/edel update rollback || { ab_end "FAIL: rolling back to slot A"; return 0; }
		ab_next 3
		;;
	3)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=1 try=0" || return 0
		/usr/bin/edel update install "$update" || { ab_end "FAIL: installing into slot B again"; return 0; }
		slot_b=$(echo "$slots" | sed -n 's/^B: .* //p')
		mkdir -p /run/ab-test/slot
		mount "$slot_b" /run/ab-test/slot
		echo "not an initramfs" >/run/ab-test/slot/boot/initramfs-virt
		umount /run/ab-test/slot
		ab_next 4
		;;
	4)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		if /usr/bin/edel update rollback; then
			ab_end "FAIL: step 4 rolled back to slot B, which is off"
			return 0
		fi
		ab_end "PASS"
		;;
	*)
		ab_end "FAIL: unknown step $step"
		;;
	esac
}
