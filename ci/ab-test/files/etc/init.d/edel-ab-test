#!/sbin/openrc-run
# Test only: CI builds this into the A/B test image with
# `edel image build --files ci/ab-test/files`; release images never have it.
# Each boot runs the next step of the test, then restarts the VM. The step
# number lives on the EFI system partition, which both slots share.
#
#   1. Slot A runs with a read-only root, and the guard turned the
#      kernel's lockup panic off once it confirmed the slot (M6.17). A
#      release.toml past its date and one with one byte changed are
#      refused. The update comes over HTTP from the host. Write markers into /home and
#      /var, delete /var/lib/ci-new, change the hostname, note the ssh
#      host key, add a user and drop a system user from this machine's
#      /etc/passwd, name the add-ons ci-hello and ci-gone, see an update
#      whose add-on does not match its list leave slot B off, then install
#      the update into slot B, ci-gone skipped with a notice (M7.2a).
#   2. Slot B runs and is confirmed. The markers, the hostname, the host
#      key and the new user survived, the dropped system user came back
#      from the slot, and so did /var/lib/ci-new; slot B's bytes are still
#      the signed image's, after a boot (M1.12), it was started by its own
#      slot.cfg under slot A's loader (M6.17), and its tagged boot loader
#      replaced slot A's on the ESP once the slot was confirmed. The
#      add-on ci-hello is mounted, its /etc file and service linked and its
#      service ran (M7.2a). Restart into slot B once more.
#  2b. Slot B runs a second time. Nothing is applied, as the add-on's
#      links already stand, and OpenRC read the services before the /etc
#      layer came: the greeting shows edel-data had it read them again
#      (M7.2a). Choose the add-on virtualization (QEMU) and apply, which
#      fetches it from slot B's list to start at the next boot (M7.2b).
#  2c. The boot tried it and the guard's confirmation kept it: qemu-img is
#      there, qemu joined the image's kvm group, the file sits beside the
#      other add-ons and nothing is pending. Choose ci-hang, whose service
#      hangs, and apply.
#  2d. The boot that tried ci-hang hung, the guard let the watchdog
#      restart it, and this boot dropped it: no ci-hang, the failure
#      recorded in last-fallback.toml and listed, virtualization kept.
#      Take ci-hang out and roll back by command.
#   3. Slot A runs again, without ci-hello and its links (M7.2a) and
#      without QEMU (M7.2b).
#      Install the update into slot B, then break slot
#      B's initramfs, the way a bad update could.
#   4. Slot B panicked on each of its three tries, so GRUB started slot A
#      again: slot A runs, slot B is switched off, a rollback to it is
#      refused, the markers survived and the fallback was recorded.
#      Install the update into slot B again with its root on a partition
#      that does not exist, as if its disk were gone (its own slot.cfg).
#  4b. (no root) Alpine's initramfs found no root and, under panic=, did
#      not wait in its rescue shell: the kernel panicked and restarted, so
#      slot A runs again and slot B is off (M6.17; ab-test.sh wants the
#      initramfs's and the kernel's lines). Install the update into slot
#      B again with a service that hangs, and without its watchdog
#      drivers, as on a machine that has none.
#   5. (hang) With no watchdog, the guard restarted slot B itself (M1.10),
#      so slot A runs and slot B is off. Install it again with a service
#      that freezes the kernel with panic reboots switched off.
#   6. (freeze) Only the hardware watchdog can restart a frozen kernel:
#      slot A runs again and slot B is off. Install it again with its own
#      health check, network, which a service writes once a default route
#      exists, and without its network services, as an update that
#      breaks the network would be.
#   7. (network) The check never passed, so slot B fell back (M1.11):
#      slot A runs again and slot B is off. Install it again with the
#      same check, and take slot A's tries away too, so no slot has a try
#      left (M6.17).
#   8. (stand down) Slot B is not healthy and no slot has a try left, so
#      the guard keeps the machine running instead of restarting it: a
#      watcher in slot B waits for the guard's note, then wants slot B
#      still running a while later on its first boot (a mark on /data
#      says so), and `edel status` saying why.
#
# Step 4 proves GRUB's count of three tries. The hang and freeze cases
# start slot B at its last try, so each proves its own way of failing a
# try in one boot instead of three (about 170 s less CI per run).

description="Edel OS A/B update test"

depend() {
	need edel-boot-ok
	# OpenRC starts the default runlevel one service at a time, so step 2's
	# wait for the add-on's greeting would hold ci-hello back if this test
	# came first.
	after ci-hello
}

ab_say() {
	echo "AB-TEST: $*"
}

ab_end() {
	ab_say "$1"
	umount "$esp" 2>/dev/null || true
	(sleep 1 && poweroff) &
}

# ab_expect LINE...: each LINE must start a line of `edel status`.
ab_expect() {
	for line in "$@"; do
		echo "$slots" | grep -q "^$line" || {
			ab_end "FAIL: step $step expected \"$line\""
			return 1
		}
	done
}

# ab_has PATH...: each PATH must exist; the markers live on /data.
ab_has() {
	for path in "$@"; do
		[ -e "$path" ] || {
			ab_end "FAIL: step $step expected $path"
			return 1
		}
	done
}

# ab_check MESSAGE COMMAND...: COMMAND must succeed.
ab_check() {
	msg=$1
	shift
	"$@" || {
		ab_end "FAIL: step $step expected $msg"
		return 1
	}
}

root_is_ro() {
	awk '$2 == "/" { opts = $4 } END { exit !(opts ~ /^ro(,|$)/) }' /proc/mounts &&
		! touch /usr/ab-test-write 2>/dev/null
}

# The add-on's service wrote its greeting, within 30 s of this step.
greeted() {
	i=0
	while [ ! -s /run/ci-hello ] && [ $i -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	grep -qx "hello from an add-on" /run/ci-hello
}

# ab_break_b NAME COMMAND [nowatchdog | network | noroot]: install the
# update into slot B again, at its last try, and add a service there whose
# start runs COMMAND in the default runlevel; with nowatchdog, take slot
# B's watchdog drivers out and softdog out of the modules its initramfs
# loads (slot.cfg's modules=), so it boots with no watchdog at all, as
# linux-lts has softdog; with network, add the health check network to
# slot B's os-release and take its network services out, and this
# test's own; with noroot, point slot B's own boot lines (slot.cfg) at a
# partition that does not exist.
ab_break_b() {
	/usr/bin/edel update --allow-http "$update" || { ab_end "FAIL: installing into slot B for $1"; return 1; }
	# The same length, so the 1024-byte block stays whole.
	sed -i 's/^B_TRY=0$/B_TRY=2/' "$esp/EFI/edel/grubenv"
	grep -q '^B_TRY=2$' "$esp/EFI/edel/grubenv" || { ab_end "FAIL: setting slot B's last try for $1"; return 1; }
	slot_b=$(echo "$slots" | awk '$1 == "B:" { print $4 }')
	mkdir -p /run/ab-test/slot
	mount "$slot_b" /run/ab-test/slot
	printf '#!/sbin/openrc-run\nstart() {\n\t%s\n}\n' "$2" >/run/ab-test/slot/etc/init.d/ab-$1
	chmod 755 /run/ab-test/slot/etc/init.d/ab-$1
	ln -s /etc/init.d/ab-$1 /run/ab-test/slot/etc/runlevels/default/ab-$1
	case "${3:-}" in
	nowatchdog)
		rm -f /run/ab-test/slot/lib/modules/*/kernel/drivers/watchdog/*
		# Only modules= loses it: softdog.soft_margin stays, unused.
		sed -i -E 's/(modules=[^ ]*)(,softdog|softdog,)/\1/' /run/ab-test/slot/usr/lib/edel/boot/slot.cfg
		! grep -Eq 'modules=[^ ]*softdog' /run/ab-test/slot/usr/lib/edel/boot/slot.cfg || {
			umount /run/ab-test/slot
			ab_end "FAIL: taking softdog out of slot B's modules for $1"
			return 1
		}
		;;
	network)
		sed -i 's/^EDEL_HEALTH="\(.*\)"$/EDEL_HEALTH="\1 network"/' /run/ab-test/slot/usr/lib/os-release
		rm -f /run/ab-test/slot/etc/runlevels/*/networking /run/ab-test/slot/etc/runlevels/*/networkmanager
		# Nothing hangs there, so this test would run in slot B and
		# find it running; the guard alone decides.
		rm -f /run/ab-test/slot/etc/runlevels/default/edel-ab-test
		;;
	noroot)
		sed -i 's/root=PARTUUID=\$partuuid /root=PARTUUID=00000000-0000-0000-0000-000000000000 /' /run/ab-test/slot/usr/lib/edel/boot/slot.cfg
		grep -q 'root=PARTUUID=00000000-' /run/ab-test/slot/usr/lib/edel/boot/slot.cfg || {
			umount /run/ab-test/slot
			ab_end "FAIL: pointing slot B's slot.cfg at no root"
			return 1
		}
		;;
	esac
	umount /run/ab-test/slot
}

# A slot keeps the shrunk image as it was signed (M1.12): its file system
# is far smaller than the 4096 MiB slot.
slot_as_signed() {
	[ "$(df -m / | awk 'NR == 2 { print $2 }')" -lt 1024 ]
}

# Whether the running slot's first SIZE bytes have the sha256 release.toml
# gives its image, read from the device after the slot booted (M1.12).
slot_matches_release() {
	manifest=$(wget -qO- "$update") || return 1
	want=$(echo "$manifest" | sed -n 's/^sha256 = "\(.*\)"$/\1/p' | head -n 1)
	size=$(echo "$manifest" | sed -n 's/^size = \([0-9]*\)$/\1/p' | head -n 1)
	device=$(echo "$slots" | awk -v s="$1:" '$1 == s { print $4 }')
	have=$(head -c "$size" "$device" | sha256sum | cut -d' ' -f1)
	echo "slot $1: $device, $size bytes, sha256 $have, release.toml $want"
	if [ -n "$want" ] && [ "$have" != "$want" ]; then
		# Which bytes differ from the signed image, and their file system's
		# view, so a failure says what wrote to the slot.
		image=$(echo "$manifest" | sed -n 's/^file = "\(.*\)"$/\1/p' | head -n 1)
		mkfifo /tmp/ab-slot
		head -c "$size" "$device" >/tmp/ab-slot &
		wget -qO- "${update%/*}/$image" | gunzip | cmp -l - /tmp/ab-slot 2>&1 | head -n 40
		echo "differing bytes: $(wget -qO- "${update%/*}/$image" | gunzip | cmp -l - "$device" 2>/dev/null | head -c 100000000 | wc -l) (counted within the image)"
		rm -f /tmp/ab-slot
		dumpe2fs -h "$device" 2>/dev/null | grep -E 'state|Last mount|Last write|Mount count|features'
	fi
	[ -n "$want" ] && [ "$have" = "$want" ]
}

# Step 8's watcher, slot B's service in the background (the guard decides
# alone): fails when slot B boots a second time, which only a restart
# does; else waits for the guard's note, then 45 s more, and wants slot B
# still running with edel status's health line. It powers the VM off.
standdown_watch='( exec >/dev/console 2>&1; . /usr/share/edel/places.sh; mark="$data_dir/ab-standdown-booted"; if [ -e "$mark" ]; then echo "AB-TEST: FAIL: step 8 slot B booted again, so the guard restarted it"; poweroff; exit; fi; touch "$mark"; sync; i=0; while [ ! -e "$no_healthy_slot" ] && [ "$i" -lt 300 ]; do sleep 1; i=$((i + 1)); done; sleep 45; s=$(/usr/bin/edel status 2>&1); echo "$s"; if echo "$s" | grep -q "^running: B" && echo "$s" | grep -q "^health: this slot is not healthy after [0-9]* s (network not reached) and no slot has a try left"; then echo "AB-TEST: PASS"; else echo "AB-TEST: FAIL: step 8 expected slot B running with a health line in edel status"; fi; poweroff ) &'

ab_next() {
	echo "$1" >"$esp/ab-test-step"
	sync
	umount "$esp"
	ab_say "step $step done, restarting for step $1"
	(sleep 1 && reboot) &
}

start() {
	# A second disk means this is the install test's live boot (M2.5): the
	# steps run on the disk it installs.
	if [ -b /dev/vdb ]; then
		ab_say "skipped: the install test's live boot"
		return 0
	fi
	esp=/run/ab-test/esp
	mkdir -p "$esp"
	mount -t vfat -o iocharset=iso8859-1 "$(findfs LABEL=EDEL-ESP)" "$esp"
	step=$(cat "$esp/ab-test-step" 2>/dev/null || echo 1)
	slots=$(/usr/bin/edel status)
	ab_say "step $step"
	echo "$slots"

	# ci/ab-test.sh serves the signed update on the host, 10.0.2.2.
	update=http://10.0.2.2:8000/release.toml

	case "$step" in
	1)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0" || return 0
		ab_has /var/lib/ci-new || return 0
		ab_check "a read-only root" root_is_ro || return 0
		# Installed from a live disk with 1024 MiB slots, as from the
		# desktop stick, into 4096 MiB (M3.3b): copied as it was (M1.12).
		ab_check "slot A as it was signed, not grown" slot_as_signed || return 0
		ab_check "slot A's boot loader on the ESP" cmp -s "$esp/EFI/edel/loader.toml" /usr/lib/edel/boot/loader.toml || return 0
		cp /usr/lib/edel/boot/loader.toml /data/ab-loader-a
		# A lockup panics while the slot starts, and no longer once the
		# guard confirmed it (M6.17).
		ab_check "softlockup_panic=1 on the command line" grep -qw softlockup_panic=1 /proc/cmdline || return 0
		ab_check "lockups no longer panic once confirmed" grep -qx 0 /proc/sys/kernel/softlockup_panic || return 0
		if refused=$(/usr/bin/edel update --allow-http http://10.0.2.2:8000/expired.toml 2>&1); then
			ab_end "FAIL: step 1 installed a release list past its date"
			return 0
		fi
		echo "$refused"
		echo "$refused" | grep -q 'refused: expired' || {
			ab_end "FAIL: step 1 expected refused: expired"
			return 0
		}
		if refused=$(/usr/bin/edel update --allow-http http://10.0.2.2:8000/bad.toml 2>&1); then
			ab_end "FAIL: step 1 installed a tampered release.toml"
			return 0
		fi
		echo "$refused"
		echo "$refused" | grep -q 'refused: signature' || {
			ab_end "FAIL: step 1 expected refused: signature"
			return 0
		}
		echo marker >/home/ab-marker
		echo marker >/var/ab-marker
		rm -r /var/lib/ci-new
		/usr/bin/edel settings set network.hostname=ab-host && /usr/bin/edel settings apply
		cp /etc/ssh/ssh_host_ed25519_key.pub /data/ab-hostkey
		adduser -D abuser
		awk -F: '$3 > 0 && $3 < 1000 { u = $1 } END { print u }' /etc/passwd >/data/ab-dropped
		sed -i "/^$(cat /data/ab-dropped):/d" /etc/passwd
		# Add-ons (M7.2a): ci-hello comes with the update; ci-gone is in no
		# list, so it is skipped with a notice. An add-on that does not
		# match its signed sha256 leaves the written slot off.
		/usr/bin/edel settings set 'addons.installed=["ci-hello", "ci-gone"]' || { ab_end "FAIL: step 1 naming the add-ons"; return 0; }
		if refused=$(/usr/bin/edel update --allow-http http://10.0.2.2:8000/badaddon.toml 2>&1); then
			ab_end "FAIL: step 1 installed a release whose add-on did not match its list"
			return 0
		fi
		echo "$refused"
		echo "$refused" | grep -q 'refused: add-on ci-hello does not match' || {
			ab_end "FAIL: step 1 expected refused: add-on ci-hello does not match"
			return 0
		}
		slots=$(/usr/bin/edel status)
		ab_expect "running: A" "B: ok=0" || return 0
		out=$(/usr/bin/edel update --allow-http "$update" 2>&1) || { echo "$out"; ab_end "FAIL: installing into slot B"; return 0; }
		echo "$out"
		echo "$out" | grep -q 'add-on ci-gone is not in' || {
			ab_end "FAIL: step 1 expected add-on ci-gone is not in"
			return 0
		}
		ab_next 2
		;;
	2)
		ab_expect "running: B" "order: B A" "B: ok=1 try=0" "A: ok=1 try=0" || return 0
		ab_has /home/ab-marker /var/ab-marker /var/lib/ci-new || return 0
		ab_check "a read-only root" root_is_ro || return 0
		ab_check "slot B as it was signed, not grown" slot_as_signed || return 0
		ab_check "slot B byte for byte the signed image" slot_matches_release B || return 0
		# Its first boot ran under slot A's loader with slot B's own lines
		# (slot.cfg), which carry the update's tag (M6.17).
		ab_check "slot B started by its own slot.cfg" grep -qw edel.tag=ci /proc/cmdline || return 0
		ab_check "slot B's boot loader on the ESP" cmp -s "$esp/EFI/edel/loader.toml" /usr/lib/edel/boot/loader.toml || return 0
		ab_check "a boot loader that differs from slot A's" sh -c '! cmp -s /data/ab-loader-a /usr/lib/edel/boot/loader.toml' || return 0
		ab_check "the previous boot loader kept" test -e "$esp/EFI/BOOT/BOOTX64.EFI.prev" || return 0
		ab_check "hostname ab-host" grep -qx ab-host /etc/hostname || return 0
		ab_check "the same ssh host key" cmp -s /etc/ssh/ssh_host_ed25519_key.pub /data/ab-hostkey || return 0
		ab_check "user abuser" grep -q '^abuser:' /etc/passwd || return 0
		ab_check "system user $(cat /data/ab-dropped) back" grep -q "^$(cat /data/ab-dropped):" /etc/passwd || return 0
		ab_check "the add-on's program" test -x /usr/bin/ci-hello || return 0
		ab_check "the add-on's /etc file linked" test -L /etc/ci-hello.conf || return 0
		ab_check "the add-on's service in the runlevel" test -L /etc/runlevels/default/ci-hello || return 0
		ab_check "the add-on's service's greeting" greeted || return 0
		ab_next 2b
		;;
	2b)
		ab_expect "running: B" "order: B A" "B: ok=1 try=0" "A: ok=1 try=0" || return 0
		ab_check "the add-on's service's greeting at a second boot" greeted || return 0
		# An add-on without an update (M7.2b): apply fetches a real one,
		# QEMU, from the list slot B came from, to start at the next boot.
		/usr/bin/edel settings set addons.installed+=virtualization || { ab_end "FAIL: step 2b choosing virtualization"; return 0; }
		out=$(/usr/bin/edel settings apply 2>&1) || { echo "$out"; ab_end "FAIL: step 2b applying"; return 0; }
		echo "$out"
		echo "$out" | grep -q 'add-on virtualization starts at the next restart' || {
			ab_end "FAIL: step 2b expected add-on virtualization starts at the next restart"
			return 0
		}
		ab_check "no qemu-img before the restart" sh -c '! test -e /usr/bin/qemu-img' || return 0
		ab_next 2c
		;;
	2c)
		# The boot tried it, and the guard's confirmation, before this
		# test, kept it beside the others (M7.2b).
		. /usr/share/edel/places.sh
		. /usr/lib/os-release
		ab_check "the add-on's qemu-img" test -x /usr/bin/qemu-img || return 0
		ab_check "qemu in the image's kvm group" grep -q '^kvm:[^:]*:[^:]*:\(.*,\)\{0,1\}qemu\(,\|$\)' /etc/group || return 0
		ab_check "virtualization kept beside the other add-ons" test -f "$addons_dir/$VERSION_ID/virtualization.ext4" || return 0
		ab_check "no pending add-on left" sh -c "! test -e '$addons_dir/$VERSION_ID/pending'" || return 0
		ab_check "edel addon list saying installed" sh -c '/usr/bin/edel addon list | grep -q "^virtualization  *installed"' || return 0
		# An add-on whose service hangs the boot that tries it.
		/usr/bin/edel settings set addons.installed+=ci-hang || { ab_end "FAIL: step 2c choosing ci-hang"; return 0; }
		/usr/bin/edel settings apply || { ab_end "FAIL: step 2c applying"; return 0; }
		ab_next 2d
		;;
	2d)
		# The boot that tried ci-hang never reaches this test; the guard
		# let the watchdog restart it, and this boot dropped the add-on.
		. /usr/share/edel/places.sh
		. /usr/lib/os-release
		ab_expect "running: B" "order: B A" || return 0
		ab_check "no ci-hang after the boot that hung" sh -c '! test -e /usr/bin/ci-hang' || return 0
		ab_check "the hang recorded" grep -q '^addons = \["ci-hang"\]' "$last_fallback" || return 0
		ab_check "ci-hang listed as failed" grep -qx ci-hang "$addons_dir/$VERSION_ID/failed" || return 0
		ab_check "edel addon list saying failed" sh -c '/usr/bin/edel addon list | grep -q "^ci-hang  *failed"' || return 0
		ab_check "virtualization still there" test -x /usr/bin/qemu-img || return 0
		/usr/bin/edel settings set addons.installed-=ci-hang || { ab_end "FAIL: step 2d taking ci-hang out"; return 0; }
		rm -f "$last_fallback"
		/usr/bin/edel rollback || { ab_end "FAIL: rolling back to slot A"; return 0; }
		ab_next 3
		;;
	3)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=1 try=0" || return 0
		ab_has /home/ab-marker /var/ab-marker || return 0
		ab_check "no virtualization add-on on slot A" sh -c '! test -e /usr/bin/qemu-img' || return 0
		ab_check "slot A's boot loader back on the ESP" cmp -s "$esp/EFI/edel/loader.toml" /data/ab-loader-a || return 0
		# Slot A has no add-on of its version, so apply took slot B's links out.
		ab_check "no add-on program on slot A" sh -c '! test -e /usr/bin/ci-hello' || return 0
		ab_check "no add-on link left in /etc" sh -c '! test -L /etc/ci-hello.conf && ! test -L /etc/init.d/ci-hello' || return 0
		ab_check "no add-on service left in the runlevel" sh -c '! test -L /etc/runlevels/default/ci-hello' || return 0
		/usr/bin/edel update --allow-http "$update" || { ab_end "FAIL: installing into slot B again"; return 0; }
		slot_b=$(echo "$slots" | awk '$1 == "B:" { print $4 }')
		mkdir -p /run/ab-test/slot
		mount "$slot_b" /run/ab-test/slot
		echo "not an initramfs" >/run/ab-test/slot/boot/initramfs-lts
		umount /run/ab-test/slot
		ab_next 4
		;;
	4)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		. /usr/share/edel/places.sh
		ab_has /home/ab-marker /var/ab-marker "$last_fallback" || return 0
		grep -q '^from = "B"' "$last_fallback" || {
			ab_end "FAIL: step 4 expected the fallback from slot B to be recorded"
			return 0
		}
		if /usr/bin/edel rollback; then
			ab_end "FAIL: step 4 rolled back to slot B, which is off"
			return 0
		fi
		ab_break_b noroot true noroot || return 0
		ab_next 4b
		;;
	4b)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		ab_break_b hang 'sleep 100000' nowatchdog || return 0
		ab_next 5
		;;
	5)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		ab_break_b freeze 'echo 0 >/proc/sys/kernel/panic; echo c >/proc/sysrq-trigger' || return 0
		ab_next 6
		;;
	6)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		ab_break_b network '. /usr/share/edel/places.sh; mkdir -p "$health_dir"; ip route | grep -q "^default" && touch "$health_dir/network"' network || return 0
		ab_next 7
		;;
	7)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		ab_break_b standdown "$standdown_watch" network || return 0
		# Slot A used its tries too: no slot has one left. The same
		# length, so the 1024-byte block stays whole.
		sed -i 's/^A_TRY=0$/A_TRY=3/' "$esp/EFI/edel/grubenv"
		grep -q '^A_TRY=3$' "$esp/EFI/edel/grubenv" || { ab_end "FAIL: taking slot A's tries for the stand-down"; return 0; }
		ab_next 8
		;;
	*)
		ab_end "FAIL: unknown step $step"
		;;
	esac
}
