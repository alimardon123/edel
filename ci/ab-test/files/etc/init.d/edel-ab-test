#!/sbin/openrc-run
# Test only: CI builds this into the A/B test image with
# `edel image build --files ci/ab-test/files`; release images never have it.
# Each boot runs the next step of the test, then restarts the VM. The step
# number lives on the EFI system partition, which both slots share.
#
#   1. Slot A runs with a read-only root. Write markers into /home and
#      /var, delete /var/lib/ci-new, change the hostname, note the ssh
#      host key, add a user and drop a system user from this machine's
#      /etc/passwd, then install the update (the disk with no partitions)
#      into slot B.
#   2. Slot B runs and is confirmed. The markers, the hostname, the host
#      key and the new user survived, the dropped system user came back
#      from the slot, and so did /var/lib/ci-new. Roll back by command.
#   3. Slot A runs again. Install the update into slot B, then break slot
#      B's initramfs, the way a bad update could.
#   4. Slot B panicked on each of its three tries, so GRUB started slot A
#      again: slot A runs, slot B is switched off, a rollback to it is
#      refused, the markers survived and the fallback was recorded.

description="Edel OS A/B update test"

depend() {
	need edel-boot-ok
}

ab_say() {
	echo "AB-TEST: $*"
}

ab_end() {
	ab_say "$1"
	umount "$esp" 2>/dev/null || true
	(sleep 1 && poweroff) &
}

# ab_expect LINE...: each LINE must start a line of `edel update status`.
ab_expect() {
	for line in "$@"; do
		echo "$slots" | grep -q "^$line" || {
			ab_end "FAIL: step $step expected \"$line\""
			return 1
		}
	done
}

# ab_has PATH...: each PATH must exist; the markers live on /data.
ab_has() {
	for path in "$@"; do
		[ -e "$path" ] || {
			ab_end "FAIL: step $step expected $path"
			return 1
		}
	done
}

# ab_check MESSAGE COMMAND...: COMMAND must succeed.
ab_check() {
	msg=$1
	shift
	"$@" || {
		ab_end "FAIL: step $step expected $msg"
		return 1
	}
}

root_is_ro() {
	awk '$2 == "/" { opts = $4 } END { exit !(opts ~ /^ro(,|$)/) }' /proc/mounts &&
		! touch /usr/ab-test-write 2>/dev/null
}

ab_next() {
	echo "$1" >"$esp/ab-test-step"
	sync
	umount "$esp"
	ab_say "step $step done, restarting for step $1"
	(sleep 1 && reboot) &
}

start() {
	esp=/run/ab-test/esp
	mkdir -p "$esp"
	mount -t vfat -o iocharset=iso8859-1 "$(findfs LABEL=EDEL-ESP)" "$esp"
	step=$(cat "$esp/ab-test-step" 2>/dev/null || echo 1)
	slots=$(/usr/bin/edel update status)
	ab_say "step $step"
	echo "$slots"

	# The update is the second disk: a bare filesystem, no partitions.
	update=''
	for d in /sys/block/vd*; do
		[ -e "$d/${d##*/}1" ] || update=/dev/${d##*/}
	done

	case "$step" in
	1)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0" || return 0
		ab_has /var/lib/ci-new || return 0
		ab_check "a read-only root" root_is_ro || return 0
		echo marker >/home/ab-marker
		echo marker >/var/ab-marker
		rm -r /var/lib/ci-new
		echo ab-host >/etc/hostname
		cp /etc/ssh/ssh_host_ed25519_key.pub /data/ab-hostkey
		adduser -D abuser
		awk -F: '$3 > 0 && $3 < 1000 { u = $1 } END { print u }' /etc/passwd >/data/ab-dropped
		sed -i "/^$(cat /data/ab-dropped):/d" /etc/passwd
		/usr/bin/edel update install "$update" || { ab_end "FAIL: installing into slot B"; return 0; }
		ab_next 2
		;;
	2)
		ab_expect "running: B" "order: B A" "B: ok=1 try=0" "A: ok=1 try=0" || return 0
		ab_has /home/ab-marker /var/ab-marker /var/lib/ci-new || return 0
		ab_check "a read-only root" root_is_ro || return 0
		ab_check "hostname ab-host" grep -qx ab-host /etc/hostname || return 0
		ab_check "the same ssh host key" cmp -s /etc/ssh/ssh_host_ed25519_key.pub /data/ab-hostkey || return 0
		ab_check "user abuser" grep -q '^abuser:' /etc/passwd || return 0
		ab_check "system user $(cat /data/ab-dropped) back" grep -q "^$(cat /data/ab-dropped):" /etc/passwd || return 0
		/usr/bin/edel update rollback || { ab_end "FAIL: rolling back to slot A"; return 0; }
		ab_next 3
		;;
	3)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=1 try=0" || return 0
		ab_has /home/ab-marker /var/ab-marker || return 0
		/usr/bin/edel update install "$update" || { ab_end "FAIL: installing into slot B again"; return 0; }
		slot_b=$(echo "$slots" | sed -n 's/^B: .* //p')
		mkdir -p /run/ab-test/slot
		mount "$slot_b" /run/ab-test/slot
		echo "not an initramfs" >/run/ab-test/slot/boot/initramfs-virt
		umount /run/ab-test/slot
		ab_next 4
		;;
	4)
		ab_expect "running: A" "order: A B" "A: ok=1 try=0" "B: ok=0 try=3" || return 0
		ab_has /home/ab-marker /var/ab-marker /data/edel/last-fallback.toml || return 0
		grep -q '^from = "B"' /data/edel/last-fallback.toml || {
			ab_end "FAIL: step 4 expected the fallback from slot B to be recorded"
			return 0
		}
		if /usr/bin/edel update rollback; then
			ab_end "FAIL: step 4 rolled back to slot B, which is off"
			return 0
		fi
		ab_end "PASS"
		;;
	*)
		ab_end "FAIL: unknown step $step"
		;;
	esac
}
