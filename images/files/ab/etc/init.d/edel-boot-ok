#!/sbin/openrc-run
# Tells the boot guard that the default runlevel was reached, the health
# file named `default-runlevel` (ADR-006, roadmap M1.5), and waits for the
# guard to confirm the slot, so the result shows before the login prompt.
# If this never runs, the guard lets the watchdog restart the machine and
# GRUB tries the slot a few times before starting the other one.

description="Confirm that this Edel OS slot starts"

depend() {
	after *
}

start() {
	ebegin "Confirming that this Edel OS slot works"
	mkdir -p /run/edel
	touch /run/edel/default-reached
	i=0
	while [ ! -s /run/edel/confirmed ] && [ "$i" -lt 30 ]; do
		sleep 1
		i=$((i + 1))
	done
	cat /run/edel/confirmed 2>/dev/null
	# The version on serial, for the boot test (M3.1).
	. /usr/lib/os-release
	echo "$PRETTY_NAME, channel $EDEL_CHANNEL, loader $EDEL_LOADER_VERSION"
	# A slot the guard could not confirm is reported as a failure.
	[ -s /run/edel/confirmed ] && ! grep -q 'could not confirm' /run/edel/confirmed
	eend $?
}
